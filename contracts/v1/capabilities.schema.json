{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "enum": [
        "in_process",
        "simulated",
        "unavailable"
      ]
    }
  },
  "required": [
    "schema_version",
    "module",
    "operations",
    "verification"
  ],
  "additionalProperties": false
}
