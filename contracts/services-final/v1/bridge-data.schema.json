{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SERVICES offline v1 DATA frame; host must also verify HMAC and persistent sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind",
    "session",
    "from",
    "to",
    "id",
    "sequence",
    "type",
    "reference",
    "mac"
  ],
  "properties": {
    "protocol": {
      "const": "services-offline-1"
    },
    "kind": {
      "const": "DATA"
    },
    "session": {
      "type": "string",
      "format": "uuid"
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "to": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "type": {
      "enum": [
        "document.reference",
        "diagnostic.ping"
      ]
    },
    "reference": {
      "type": "string",
      "format": "uuid"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
