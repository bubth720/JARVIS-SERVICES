{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SERVICES local v1 recipe",
  "type": "array",
  "maxItems": 16,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "enum": [
          "NORMALIZE",
          "DEDUPLICATE",
          "FILTER",
          "SORT_TEXT",
          "SORT_NUMERIC",
          "STATS",
          "AGGREGATE"
        ]
      },
      "column": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      },
      "value": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1000
      }
    }
  }
}
